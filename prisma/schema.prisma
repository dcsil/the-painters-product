// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User model for managing users who upload data
model User {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String?
  passwordHash String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  uploads      Upload[]
  preferences  UserPreferences?
  groundTruths GroundTruth[]
}

// User preferences for analysis defaults
model UserPreferences {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAnalysisMode String   @default("gemini") // "gemini" | "groq" | "both"
  defaultAnalyses     String   @default("hallucination,bias,toxicity")
  alertEmail          String?  // email to notify when a chat analysis completes
  biasThreshold       Int      @default(70) // live monitoring bias alert threshold (0–100)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Ground truth knowledge base for grounding analysis
model GroundTruth {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  content   String
  fileType  String   // "txt" | "md" | "json"
  isBuiltIn Boolean  @default(false)
  createdAt DateTime @default(now())
  uploads   Upload[]

  @@index([userId])
}

// Upload model for tracking conversation data uploads
model Upload {
  id               String       @id @default(cuid())
  userId           String?      // Null for chat-originated uploads (no logged-in customer)
  user             User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName         String
  fileSize         Int          // File size in bytes
  uploadedAt       DateTime     @default(now())
  status           String       // "pending", "processing", "completed", "failed"
  errorMessage     String?      // Error message if status is "failed"
  analysisMode     String?      // "gemini" | "groq" | "both"
  groundTruthId    String?
  groundTruth      GroundTruth? @relation(fields: [groundTruthId], references: [id], onDelete: SetNull)
  selectedAnalyses String?      // comma-separated: "hallucination,bias,toxicity"
  source           String       @default("upload") // "upload" | "chat"
  analyses         Analysis[]
  chatSession      ChatSession?
}

// Chat session model for customer chatbot interactions
model ChatSession {
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now())
  lastActivityAt DateTime      @default(now())
  endedAt        DateTime?
  endedReason    String?       // "user" | "violation"
  uploadId       String?       @unique
  upload         Upload?       @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  messages       ChatMessage[]
}

// Individual messages within a chat session
model ChatMessage {
  id             String      @id @default(cuid())
  sessionId      String
  session        ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role           String      // "user" | "assistant"
  content        String
  monitoringData String?     // JSON of LiveMonitorResult, only set on role="assistant" messages
  createdAt      DateTime    @default(now())

  @@index([sessionId])
}

// Analysis model for storing analysis results
model Analysis {
  id              String   @id @default(cuid())
  uploadId        String
  upload          Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  analysisType    String   // "hallucination", "gender_bias", "toxicity", etc.
  result          String   // JSON string with detailed results
  confidence      Float?   // Confidence score (0-1)
  detectedIssues  Int      @default(0) // Number of issues detected
  createdAt       DateTime @default(now())
  
  @@index([uploadId])
  @@index([analysisType])
}
